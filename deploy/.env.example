# Copy this file to .env and adjust values for your environment
# DO NOT commit .env to git

POSTGRES_DB=magbodb
POSTGRES_USER=magbo
POSTGRES_PASSWORD=changeme_in_prod_use_a_long_random_value

# Generate with: openssl rand -base64 64 | tr -d '\n'
MAGBO_JWT_SECRET=ZGV2U2VjcmV0Q2hhbmdlSW5Qcm9kdWN0aW9uV2l0aEVudlZhckxvbmdFbm91Z2hGb3JIUzM4NEFsZ29yaXRobVNlY3VyZUtleQ==

# Optional: if empty, webhook accepts any caller
MAGBO_WEBHOOK_TOKEN=

# ── FUSO HORÁRIO ─────────────────────────────────────────────────────
# Raramente se mexe: existe para poder ser mudado sem editar o compose.
# ⚠️ NÃO APAGAR do docker-compose.yml. As imagens sobem em UTC, a JVM adota o
# fuso do container, e todo `LocalDateTime.now()` do backend passa a gravar
# TRÊS HORAS À FRENTE das passagens (que o EventTimeResolver escreve em
# America/Sao_Paulo). Medido em 25/08/2026: 17:27 de Brasília gravado como
# 20:27. Onde uma hora de `now()` é COMPARADA com uma hora de passagem, o
# desvio deixa de ser um carimbo torto e vira regra errada.
TZ=America/Sao_Paulo

# ── CREDENCIAIS DE ADMINISTRAÇÃO ─────────────────────────────────────
# ⚠️ OBRIGATÓRIAS: o `docker compose up` RECUSA subir sem elas. Não têm valor
# de reserva de propósito — vazio falha em silêncio nas duas (PIN vazio torna
# o Painel Administrativo inalcançável; senha vazia cria, numa base NOVA, um
# administrador inicial SEM SENHA).
#
# PIN do Painel Administrativo. ⚠️ NÃO deixar 1234.
ADMIN_PIN=

# Senha do administrador INICIAL da aplicação.
# ⚠️ Só tem efeito numa base SEM o utilizador `admin`: o AdminBootstrap sai na
# primeira linha se ele já existir. Para trocar a senha de um admin já criado,
# use a tela de operadores — mudar isto e recriar o container NÃO muda nada.
MAGBO_ADMIN_PASSWORD=

# ── RÉGIME DE SORTIE ─────────────────────────────────────────────────
# false (padrão) = a regra não roda e nada muda no portão.
# true            = o portão passa a avaliar e a registrar veredictos.
#
# ⚠️ ORDEM OBRIGATÓRIA para ligar:
#   1. aplicar V014 e V015  (deploy/migrations/README.md)
#   2. a Vie Scolaire carregar os regimes (tela Régimes)
#   3. só então MAGBO_REGIME_HABILITADO=true e recriar o container
# Ligar antes do passo 1 arma uma falha ADIADA: o CHECK de denial_reason ainda
# não conhece REGIME_NOT_ALLOWED, e o INSERT falha dentro da transação da
# passagem. Ligar antes do passo 2 não quebra nada — todo aluno responde
# INCONNU (cinza), que é o previsto para o dia 1.
MAGBO_REGIME_HABILITADO=false

# =====================================================================
# LICENCE (ADR-006)
# =====================================================================
# ⚠️ IL N'Y A AUCUN SECRET DE LICENCE ICI, et c'est le point : la licence est
# un FICHIER SIGNE, pas un mot de passe. Il se depose dans
# deploy/licence/licence.magbo (ignore par git) et le compose le monte en
# lecture seule. La cle PRIVEE qui le signe reste chez Sam et n'approche
# jamais ni ce depot ni cette VM.
#
# Les deux variables ci-dessous ont des valeurs par defaut correctes : ne les
# decommentez que si vous savez pourquoi.

# Chemin DANS le conteneur. Doit correspondre au volume du compose.
# ⚠️ Jamais sous /app : c'est la sortie de Maven, que `mvn clean` efface.
#MAGBO_LICENCE_PATH=/licence/licence.magbo

# ⚠️ IL N'Y A PAS DE VARIABLE POUR L'HEURE DU CONTROLE QUOTIDIEN.
# Elle etait configurable ; une valeur mal saisie faisait echouer le demarrage
# du backend ENTIER (plus de webhook, plus de PPMS) pour une faute de frappe
# dans une couche commerciale. Le reglage a ete supprime : le verdict se
# recalcule de toute facon au changement de jour.

# ⚠️ IL N'EXISTE PAS DE VARIABLE POUR DESACTIVER LA LICENCE.
# `magbo.licence.gate.enabled` existe dans le code mais est IGNOREE en profil
# prod : elle ne sert qu'a la suite de tests. La mettre ici ne ferait rien —
# et croire le contraire est pire que savoir que la porte n'existe pas.
#
# Verifier l'etat apres le demarrage :
#   curl -s http://localhost:8080/api/health | grep -o '"licence".*'
# Procedure complete : docs/operacional/procedimento-licence.md
