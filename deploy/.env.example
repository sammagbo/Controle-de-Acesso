# Copy this file to .env and adjust values for your environment
# DO NOT commit .env to git

POSTGRES_DB=magbodb
POSTGRES_USER=magbo
POSTGRES_PASSWORD=changeme_in_prod_use_a_long_random_value

# Generate with: openssl rand -base64 64 | tr -d '\n'
MAGBO_JWT_SECRET=ZGV2U2VjcmV0Q2hhbmdlSW5Qcm9kdWN0aW9uV2l0aEVudlZhckxvbmdFbm91Z2hGb3JIUzM4NEFsZ29yaXRobVNlY3VyZUtleQ==

# Optional: if empty, webhook accepts any caller
MAGBO_WEBHOOK_TOKEN=

# ── RÉGIME DE SORTIE ─────────────────────────────────────────────────
# false (padrão) = a regra não roda e nada muda no portão.
# true            = o portão passa a avaliar e a registrar veredictos.
#
# ⚠️ ORDEM OBRIGATÓRIA para ligar:
#   1. aplicar V014 e V015  (deploy/migrations/README.md)
#   2. a Vie Scolaire carregar os regimes (tela Régimes)
#   3. só então MAGBO_REGIME_HABILITADO=true e recriar o container
# Ligar antes do passo 1 arma uma falha ADIADA: o CHECK de denial_reason ainda
# não conhece REGIME_NOT_ALLOWED, e o INSERT falha dentro da transação da
# passagem. Ligar antes do passo 2 não quebra nada — todo aluno responde
# INCONNU (cinza), que é o previsto para o dia 1.
MAGBO_REGIME_HABILITADO=false
