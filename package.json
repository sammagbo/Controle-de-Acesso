{
  "name": "magbo-access-control",
  "version": "2.1.0",
  "description": "Sistema de Controle de Acesso Institucional — Lycée Molière",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:prod": "set NODE_ENV=production && electron .",
    "build:win": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "verify:package": "node scripts/verify-package.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "livre": "node scripts/build-livre.js",
    "livre:pdf": "node scripts/build-livre.js && node scripts/paginer-livre.js"
  },
  "build": {
    "appId": "com.magbo.access",
    "productName": "MAGBO Access Control",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "css/**/*",
      "js/**/*",
      "libs/**/*",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MAGBO Access Control",
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "MAGBO-Access-Control-Portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jimp": "^1.6.1",
    "jsdom": "^25.0.1",
    "png-to-ico": "^3.0.1",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sammagbo/Controle-de-Acesso.git"
  },
  "keywords": [
    "access-control",
    "electron",
    "lycee-moliere"
  ],
  "author": "Sammy K. Magbo",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sammagbo/Controle-de-Acesso/issues"
  },
  "homepage": "https://github.com/sammagbo/Controle-de-Acesso#readme"
}
